{
  "name": "clef-payload",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "node scripts/next-build.mjs",
    "start": "next start -p 3001",
    "payload": "payload",
    "payload:seed": "tsx scripts/seed-payload.ts",
    "payload:seed:all-products": "tsx scripts/seed-payload.ts --all-products-only",
    "payload:seed:clef-edit": "tsx scripts/seed-payload.ts --clef-edit-only",
    "payload:seed:reviews": "tsx scripts/seed-payload.ts --reviews-only",
    "cf:build": "cross-env DEPLOYMENT_TARGET=cloudflare-workers NODE_ENV=production NEXT_PUBLIC_SERVER_URL=https://clef-payload-preview.easondev.workers.dev opennextjs-cloudflare build --noMinify && node scripts/patch-opennext-windows.mjs",
    "cf:deploy": "npm run cf:build && wrangler deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:migrate:create": "cross-env DEPLOYMENT_TARGET=cloudflare-workers NODE_ENV=production payload migrate:create",
    "cf:migrate:apply": "cross-env DEPLOYMENT_TARGET=cloudflare-workers NODE_ENV=production payload migrate",
    "payload:admin:bootstrap:production": "cross-env DEPLOYMENT_TARGET=cloudflare-workers NODE_ENV=production PAYLOAD_USE_WRANGLER_REMOTE=true PAYLOAD_PUBLIC_SERVER_URL=https://clef-payload-preview.easondev.workers.dev tsx scripts/bootstrap-production-admin.ts",
    "payload:admin:check:production": "cross-env DEPLOYMENT_TARGET=cloudflare-workers NODE_ENV=production PAYLOAD_USE_WRANGLER_REMOTE=true PAYLOAD_ADMIN_CHECK_ONLY=true PAYLOAD_PUBLIC_SERVER_URL=https://clef-payload-preview.easondev.workers.dev tsx scripts/bootstrap-production-admin.ts",
    "auth:verify:local": "node scripts/verify-local-auth.mjs",
    "auth:verify:production": "cross-env PAYLOAD_PUBLIC_SERVER_URL=https://clef-payload-preview.easondev.workers.dev node scripts/verify-production-auth.mjs",
    "test": "node --test scripts/email-config.test.mjs scripts/all-products-pages-config.test.mjs scripts/production-auth-config.test.mjs",
    "test:email": "tsx scripts/test-email.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.1",
    "@payloadcms/db-d1-sqlite": "3.86.0",
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/email-resend": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/storage-r2": "3.86.0",
    "dotenv": "^17.2.3",
    "graphql": "^16.14.2",
    "next": "16.2.10",
    "payload": "3.86.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "^19.1.6",
    "cross-env": "^10.1.0",
    "playwright": "1.59.1",
    "tsx": "^4.23.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.110.0"
  }
}
