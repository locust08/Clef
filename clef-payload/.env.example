PAYLOAD_SECRET=replace-with-long-random-secret
PAYLOAD_DATABASE_URL=your-postgres-url
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001
PAYLOAD_ALLOWED_ORIGINS=http://localhost:3000

# Operator-only production bootstrap inputs, never normal runtime requirements.
# Store values temporarily in Doppler, never Git; delete the password after verification.
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=
PAYLOAD_ADMIN_CHECK_ONLY=false
PAYLOAD_ADMIN_RESET=false
PAYLOAD_ADMIN_ALLOW_ADDITIONAL=false
PAYLOAD_PRODUCTION_BOOTSTRAP_CONFIRM=

# Server-only Payload auth email settings. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
EMAIL_FROM_NAME=Clef
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_REPLY_TO=
EMAIL_ADMIN_TO=
EMAIL_ENABLED=false
