PAYLOAD_SECRET=replace-with-long-random-secret
PAYLOAD_DATABASE_URL=your-postgres-url
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# SMTP email is required for Payload forgot-password emails.
# Example Resend SMTP values:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=your-resend-api-key
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME=CLEF Payload

# Optional: force all outgoing emails to a single inbox during testing.
# SMTP_OVERRIDE_RECIPIENT=

# Optional: skip SMTP verification during boot if your provider blocks verify.
# SMTP_SKIP_VERIFY=false
