{
    "name": "app",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev --webpack",
        "dev:doppler": "doppler run -- npm run dev",
        "build": "node scripts/next-build.mjs",
        "build:doppler": "doppler run -- npm run build",
        "cf:build": "cross-env DEPLOYMENT_TARGET=cloudflare-workers NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://clef-medusa.easondev.workers.dev NEXT_PUBLIC_PAYLOAD_URL=https://clef-payload-preview.easondev.workers.dev opennextjs-cloudflare build --noMinify",
        "cf:preview": "npm run cf:build && wrangler dev",
        "cf:deploy": "npm run cf:build && wrangler deploy",
        "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
        "start": "next start",
        "lint": "eslint src next.config.mjs eslint.config.mjs",
        "type-check": "tsc --noEmit",
        "typecheck:doppler": "doppler run -- npm run type-check",
        "test:email": "tsx scripts/test-email.ts",
        "test": "node scripts/storefront-functions.test.mjs && node scripts/homepage-cms-production.test.mjs && node scripts/home-promo-carousel.test.mjs && node scripts/home-promotion-spacing.test.mjs && tsx --test src/lib/leads/submit-lead.test.ts src/lib/checkout/complete-order.test.ts src/lib/medusa/orders.test.ts src/lib/cms-all-products.test.ts src/lib/cms-homepage.test.ts",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@medusajs/js-sdk": "^2.17.2",
        "@stripe/react-stripe-js": "^6.7.0",
        "@stripe/stripe-js": "^9.9.0",
        "@types/pg": "^8.20.0",
        "next": "^16.2.10",
        "pg": "^8.22.0",
        "react": "^19.2.7",
        "react-apexcharts": "^1.4.0",
        "react-dom": "^19.2.7",
        "resend": "^6.17.2"
    },
    "devDependencies": {
        "@opennextjs/cloudflare": "^1.20.1",
        "@playwright/test": "^1.61.1",
        "@types/node": "22.20.0",
        "@types/react": "19.2.17",
        "@types/react-dom": "^19.1.6",
        "autoprefixer": "^10.4.21",
        "cross-env": "^10.1.0",
        "eslint": "^9.32.0",
        "eslint-config-next": "^16.2.10",
        "postcss": "^8.5.6",
        "tailwindcss": "^3.0.7",
        "tsx": "^4.23.0",
        "typescript": "^5.8.3",
        "wrangler": "^4.112.0"
    }
}
